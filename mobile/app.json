{
  "expo": {
    "name": "Farm2Flavour",
    "slug": "farm2flavour",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "farm2flavour",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 21,
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": false,
      "permissions": ["RECORD_AUDIO", "POST_NOTIFICATIONS"],
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F5",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.farm2flavour.app",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#047857",
          "defaultChannel": "order-updates",
          "sounds": []
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Farm2Flavour to hear your voice order.",
          "speechRecognitionPermission": "Allow Farm2Flavour to turn your voice order into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2dafb597-0027-47eb-a089-43944f29749c"
      }
    },
    "owner": "ragavananthan"
  }
}
