EXPO_PUBLIC_SUPABASE_URL=your-supabase-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_BUSINESS_ID=your-business-uuid

# Admin origin + Sam turn endpoint, e.g. http://192.168.1.10:3000/api/sam/turn
# Do not put Ollama URLs or service_role here.
EXPO_PUBLIC_SAM_API_URL=

# EAS APK: keep the same three values as EAS secrets (preview + production).
# Do not put service_role here. Build from mobile/: npx eas-cli build -p android --profile preview
