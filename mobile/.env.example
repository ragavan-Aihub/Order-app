# Local dev: use the SAME Supabase project as admin/.env (staging recommended).
# EAS preview/production builds use expo.dev Environment variables, not this file.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
EXPO_PUBLIC_BUSINESS_ID=your-business-uuid-in-that-project
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Admin HTTPS origin for product share links (no trailing slash).
# Local: http://192.168.x.x:3001  |  Prod APK: https://your-admin.vercel.app
EXPO_PUBLIC_SHARE_BASE_URL=

# Voice ordering (optional): admin URL, e.g. http://192.168.x.x:3001/api/sam/turn
EXPO_PUBLIC_SAM_API_URL=

# After changing any EXPO_PUBLIC_* value: npx expo start -c