{
  "expo": {
    "name": "Farm2Flavour Delivery",
    "slug": "farm2flavour-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "farm2flavour-delivery",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.farm2flavour.delivery"
    },
    "android": {
      "versionCode": 3,
      "package": "com.farm2flavour.delivery",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F5",
        "foregroundImage": "./assets/images/icon.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to choose your shop UPI QR image."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9289f5f2-592d-452d-b19d-94a9af1786b9"
      }
    },
    "owner": "ragavananthan"
  }
}
