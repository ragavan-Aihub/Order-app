{
  "expo": {
    "name": "Farm2Flavour Delivery",
    "slug": "farm2flavour-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "farm2flavour-delivery",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.farm2flavour.delivery"
    },
    "android": {
      "package": "com.farm2flavour.delivery",
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F5",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
