# Local dev: point at STAGING (or local supabase start), not production.
# Production values live only on Vercel — see docs/vercel-admin-deploy.md

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key

# Server-only (order/product push via Edge Functions). Never expose to Expo apps.
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Optional: Sam voice turn proxy when testing Sam from a device (LAN IP + admin port)
# SAM is not required for normal admin use.